printf("  Loading DOCX support...")

; Set SdmDocxDataTrigger to the procedure object here, not as DOCX->DataTrigger: on some
; Virtuoso builds the alist "->" form returns nil, so init sees a non-function trigger.

let((DOCX
	(module_description "Adds a Word Document (*.docx) view type to Virtuoso")
	(Softworks VrtImport['Softworks]))

DOCX = let((
	(viewSetup '(
	;(viewType  appName dataTrigger parentType)
	("docx" "libreoffice_docx" "SdmDocxDataTrigger" nil)
	)))

; Register all DOCX Cellview Types
procedure(init() let(((out t))
	Softworks->initDeRegApp(viewSetup)
))

; Uninitialize all DOCX views so they can be redefined
procedure(uninit() let(((out t))
	Softworks->uninitDeRegApp(viewSetup)
))

procedure(startReader(filePath)
	ipcBeginProcess(strcat("libreoffice --writer " filePath) "" nil nil))

; Must run in nested context so NewDocViewGUI->CombinedGUI (nested) is callable, like XLSX.
procedure(DataTrigger(@optional argList)
	if(not(argList) then
		warn("Softworks: SdmDocxDataTrigger called with nil argList")
		t
	else
	let((libName cellName lname file fileReadable objId viewFileName viewName rootType)
	libName = argList->libName
	cellName = argList->cellName
	viewName = argList->viewName
	rootType = argList->rootType
	; viewFileId is a dd object on argList: use ~>name, not ->name (avoids "not a function - nil").
	viewFileName = let((vf)
	  vf = argList->viewFileId
	  if(not(vf) then argList->fileName
	  else if(stringp(vf) then vf
	  else vf~>name)))
	; DEBASE often passes nil fileName and viewFileId. ddMap can return nil for some custom types.
	when(not(viewFileName)
	  viewFileName = ddMapGetViewTypeFileName(
	    if(argList->viewType then argList->viewType else argList->rootType)))
	; Conventional per-view file name when map is still nil (e.g. report -> report.docx).
	when(not(viewFileName)
	  viewFileName = strcat(viewName ".docx"))
	lname = if(argList->libId then argList->libId~>name else argList->libName)

	; With explicit file name first; then as NewDocViewGUI/DocImport (nil nil) when that misses.
	objId = if(viewFileName then ddGetObj(lname cellName viewName viewFileName nil "r") else nil)
	unless(objId
	  objId = ddGetObj(lname cellName viewName nil nil "r"))
	if(objId then
		; Open existing file
		file = ddGetObjWritePath(objId)
		fileReadable = if(file then isFile(file) else nil)
		if(fileReadable then
			let(((docx VrtImport['Softworks]->DOCX))
			  cond(
			    ((eq docx nil)
			     warn("[Softworks DOCX] DOCX module not loaded; cannot open editor."))
			    ((neq procedurep(docx->startReader) nil)
			     docx->startReader(file))
			    ((equal 0 0)
			     warn("[Softworks DOCX] startReader is not a procedure; cannot open editor."))))
		else
			warn("Warning, couldn't open %s / %s / %s as a DOCX view" libName cellName viewName))
	else
		let(((writePath softworksCreateDocViewFromTemplate(lname cellName viewName viewFileName "docx/docxTemplate.docx")))
		  when(writePath
		    let(((docx VrtImport['Softworks]->DOCX))
		      cond(((neq procedurep(docx->startReader) nil) docx->startReader(writePath))))))
	)
	t
	)))

SdmDocxDataTrigger = DataTrigger
putd('SdmDocxDataTrigger SdmDocxDataTrigger)
unless(procedurep(SdmDocxDataTrigger)
  warn(sprintf(nil
    "[Softworks DOCX] FATAL: SdmDocxDataTrigger is not a procedure after bind (value=%L); DEBASE docx trigger will fail."
    SdmDocxDataTrigger)))

list(nil
	'init init
	'uninit uninit
	'DataTrigger DataTrigger
	'startReader startReader
))

putprop(Softworks DOCX 'DOCX)
DOCX->init()
unless(procedurep(SdmDocxDataTrigger)
  warn(sprintf(nil
    "[Softworks DOCX] FATAL: SdmDocxDataTrigger lost procedure status after init (value=%L)."
    SdmDocxDataTrigger)))

)

printf("done\n")
